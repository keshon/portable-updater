{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable updater container configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "adapter",
    "runtime",
    "channel",
    "saves"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": 2
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "stable",
        "nightly",
        "latest"
      ]
    },
    "saves": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
