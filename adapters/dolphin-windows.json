{
  "$schema": "../schemas/adapter.schema.json",
  "schema": 1,
  "id": "dolphin-windows-x64",
  "platform": "windows",
  "architecture": "amd64",
  "executable": "Dolphin.exe",
  "version": {
    "kind": "artifact-sha256"
  },
  "source": {
    "provider": "json-feed",
    "checksum": "when-published",
    "feed": {
      "channels": {
        "stable": "https://dolphin-emu.org/update/latest/beta",
        "latest": "https://dolphin-emu.org/update/latest/beta",
        "nightly": "https://dolphin-emu.org/update/latest/dev"
      },
      "version": "/shortrev",
      "updated_at": "/hash",
      "asset": "/artifacts",
      "match": {
        "/system": "Windows x64"
      },
      "url": "/url",
      "size_from_head": true,
      "allowed_download_prefixes": [
        "https://dl.dolphin-emu.org/"
      ]
    }
  },
  "preserve": [
    "portable.txt",
    "ReShade.ini",
    "ReShadeMGS4_1.ini",
    "reshade-shaders",
    "reshade-vulkan"
  ],
  "required_package": [
    "Dolphin.exe",
    "Sys"
  ],
  "required_state": [
    "portable.txt"
  ]
}
