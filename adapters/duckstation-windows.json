{
  "$schema": "../schemas/adapter.schema.json",
  "schema": 1,
  "id": "duckstation-windows-x64",
  "platform": "windows",
  "architecture": "amd64",
  "executable": "duckstation-qt-x64-ReleaseLTCG.exe",
  "version": {
    "kind": "artifact-sha256"
  },
  "source": {
    "provider": "github",
    "repository": "stenzek/duckstation",
    "asset_pattern": "^duckstation-windows-x64-release\\.zip$"
  },
  "preserve": [
    "settings.ini",
    "portable.txt",
    "playtime.dat"
  ],
  "required_package": [
    "duckstation-qt-x64-ReleaseLTCG.exe",
    "Qt6Core.dll",
    "Qt6Gui.dll",
    "Qt6Widgets.dll",
    "QtPlugins",
    "resources",
    "translations"
  ],
  "required_state": [
    "portable.txt",
    "settings.ini"
  ]
}
