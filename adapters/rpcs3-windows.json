{
  "$schema": "../schemas/adapter.schema.json",
  "schema": 1,
  "id": "rpcs3-windows-x64",
  "display_name": "RPCS3",
  "platform": "windows",
  "architecture": "amd64",
  "executable": "rpcs3.exe",
  "version": {
    "kind": "artifact-sha256"
  },
  "source": {
    "provider": "json-feed",
    "feed": {
      "channels": {
        "stable": "https://update.rpcs3.net/?api=v3&os_type=windows&os_arch=x64&os_version={os_version}",
        "latest": "https://update.rpcs3.net/?api=v3&os_type=windows&os_arch=x64&os_version={os_version}",
        "nightly": "https://update.rpcs3.net/?api=v3&os_type=windows&os_arch=x64&os_version={os_version}"
      },
      "version": "/latest_build/version",
      "asset": "/latest_build/windows",
      "url": "/download",
      "size": "/size",
      "sha256": "/checksum",
      "allowed_download_prefixes": [
        "https://github.com/RPCS3/rpcs3-binaries-win/releases/download/"
      ]
    }
  },
  "preserve": [
    "config",
    "config.yml",
    "games.yml",
    "GuiConfigs",
    "patches",
    "sounds",
    "savestates",
    "screenshots",
    "captures",
    "Icons",
    "ReShade.ini",
    "ReShadePreset.ini",
    "reshade-shaders",
    "reshade-vulkan"
  ],
  "required_package": [
    "rpcs3.exe",
    "Qt6Core.dll"
  ],
  "required_state": [
    "config/vfs.yml"
  ]
}
